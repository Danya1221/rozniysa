# Новый бот витрины/управления; отличный от токена zayavki.
BOT_TOKEN=
ADMIN_IDS=
API_ID=
API_HASH=
# Одинаковая общая PostgreSQL-база в обоих сервисах.
RETAIL_DATABASE_URL=
# По умолчанию совпадает с RETAIL_DATABASE_URL (PostgreSQL).
DATABASE_URL=
# Username бота оформления без @.
ORDER_BOT_USERNAME=
# Канал / супергруппа: @username или -100...; можно привязать через /bind.
TARGET_CHANNEL=
SUPPLIER_BOT=
SOURCE_MODE=bot
REQUEST_TEXT=/prices
BUTTON_PATH=
SUPPLIER_BOT_2=
SOURCE_MODE_2=bot
REQUEST_TEXT_2=/prices
BUTTON_PATH_2=
CLOSED_TEXT_1=
CLOSED_TEXT_2=
# Сессии оставь пустыми и выполни /login в новом боте; вход сохранится.
SESSION_STRING=
SESSION_STRING_2=
SETUP_MODE=false
POLL_SECONDS=600
RESPONSE_TIMEOUT=45
PRICE_SETTLE_SECONDS=4
AFTER_ACTION_DELAY=1.5
MAX_CATALOG_PAGES=200
FEED_HISTORY_LIMIT=0
SEND_DELAY=1
MARKUP=0
MARKUP_PERCENT=0
PRICE_CURRENCY=RUB
ALLOW_ACCESSORIES=true
SIM_FILTER=all
TIMEZONE=Europe/Moscow
